# Corretora RL - SPA fallback for React Router on Apache/Locaweb
RewriteEngine On

# Serve existing files/directories normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send client-side routes to the Vite/React entry point
RewriteRule ^ index.html [L]
